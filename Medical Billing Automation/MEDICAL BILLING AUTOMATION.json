      "parameters": {
        "jsCode": "// This code simulates checking a real-world insurance eligibility API.\n// In a real n8n workflow, you would use an HTTP Request node to query the payer's API.\n\nfor (const item of items) {\n  // Generate a random number between 0 and 1.\n  const randomNumber = Math.random(); \n  \n  // 90% chance of being verified, 10% chance of failure for testing purposes.\n  if (randomNumber < 0.9) { \n    // Add a new field to the item indicating success\n    item.json.isInsuranceVerified = true;\n    item.json.verificationMessage = \"Eligible and Active\";\n  } else {\n    // Add a new field to the item indicating failure\n    item.json.isInsuranceVerified = false;\n    item.json.verificationMessage = \"Policy Inactive or Service Not Covered\";\n  }\n}\n\n// Return the modified data items\nreturn items;"
      },
