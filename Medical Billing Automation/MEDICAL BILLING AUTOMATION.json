    {
      "parameters": {
        "jsCode": "for (const item of items) {\n    const data = item.json;\n    let errors = [];\n\n    // --- Check 1: ICD Code Format (Usually 3 to 7 alphanumeric characters) ---\n    // Using a common standard: check if the code is the correct length for a valid diagnosis.\n    const icdCode = data.ICD_CODE_FINAL ? data.ICD_CODE_FINAL.toString() : '';\n    if (icdCode.length < 3 || icdCode.length > 7) {\n        errors.push(\"ICD-10 Code is not between 3 and 7 characters (Scrubbing Check 1).\");\n    }\n\n    // --- Check 2: CPT Code Format (Usually 5 digits) ---\n    // CPT codes are typically 5 numerical digits.\n    const cptCode = data.CPT_CODE_FINAL ? data.CPT_CODE_FINAL.toString() : '';\n    // This regex checks for exactly 5 digits.\n    if (!/^\\d{5}$/.test(cptCode)) { \n        errors.push(\"CPT Code is not exactly 5 digits (Scrubbing Check 2).\");\n    }\n    \n    // --- Check 3: Charge Amount Check ---\n    // Ensure the total charge is a number greater than zero.\n    if (typeof data.TOTAL_CHARGE !== 'number' || data.TOTAL_CHARGE <= 0) {\n        errors.push(\"Total Billed Amount is not a valid positive number (Scrubbing Check 3).\");\n    }\n\n    // --- Final Scrubbing Decision ---\n    if (errors.length === 0) {\n        item.json.isClaimScrubbed = true;\n        item.json.scrubbingErrors = \"None\";\n    } else {\n        item.json.isClaimScrubbed = false;\n        item.json.scrubbingErrors = errors.join(\"; \"); // Combine all errors into one string\n    }\n}\n\nreturn items;"
      },
