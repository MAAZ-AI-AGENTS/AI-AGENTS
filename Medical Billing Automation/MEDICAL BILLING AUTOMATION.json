    {
      "parameters": {
        "jsCode": "for (const item of items) {\n  // Simulate claim status (20% Denied, 20% Pending, 60% Approved)\n  const statusRoll = Math.random();\n  \n  if (statusRoll < 0.2) { // 20% chance of Denial\n    item.json.finalStatus = \"Denied\";\n    item.json.denialReason = \"Code mismatch: CPT not covered for this ICD-10.\";\n    item.json.paymentAmount = 0.00;\n  } else if (statusRoll < 0.4) { // 20% chance of Pending (0.2 to 0.4)\n    item.json.finalStatus = \"Pending\";\n    item.json.denialReason = \"Currently under manual review.\";\n    item.json.paymentAmount = 0.00;\n  } else { // 60% chance of Approval (0.4 to 1.0)\n    item.json.finalStatus = \"Approved\";\n    item.json.denialReason = \"None\";\n    // Simulate payment amount (e.g., 80% of total billed)\n    item.json.paymentAmount = item.json.TOTAL_CHARGE * 0.8;\n  }\n}\n\nreturn items;"
      },
